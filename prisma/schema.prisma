// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Outbox {
  id            String    @id @default(uuid())
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  evento        String
  payload       Json
  correlationId String    @map("correlation_id")
  traceparent   String?
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")
  tentativas    Int       @default(0)
  ultimoErro    String?   @map("ultimo_erro") @db.Text

  @@index([publishedAt, createdAt])
  @@map("outbox")
}

model MensagemProcessada {
  id          String   @id @default(uuid())
  eventId     String   @unique @map("event_id")
  evento      String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("mensagens_processadas")
}

enum StatusOrcamento {
  GERADO
  APROVADO
  REPROVADO
}

model Orcamento {
  id               String          @id @default(uuid())
  osId             String          @unique @map("os_id")
  clienteId        String?         @map("cliente_id")
  status           StatusOrcamento
  valorTotal       Decimal         @map("valor_total") @db.Decimal(10, 2)
  motivoReprovacao String?         @map("motivo_reprovacao") @db.Text
  correlationId    String?         @map("correlation_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  itens            OrcamentoItem[]

  @@map("orcamentos")
}

enum TipoItemOrcamento {
  SERVICO
  PECA
}

model OrcamentoItem {
  id            String            @id @default(uuid())
  orcamentoId   String            @map("orcamento_id")
  orcamento     Orcamento         @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  tipo          TipoItemOrcamento
  refId         String            @map("ref_id")
  descricao     String
  quantidade    Int
  precoUnitario Decimal           @map("preco_unitario") @db.Decimal(10, 2)

  @@index([orcamentoId])
  @@map("orcamento_itens")
}

enum StatusCobranca {
  PENDENTE
  CONFIRMADA
  RECUSADA
}

// Charge of an OS. `orcamento_id` is a plain column on purpose (no FK): the
// cobrancas module stays decoupled from the orcamentos tables, and a RECUSADA
// charge may exist without any orcamento (motivo = orcamento_inexistente).
model Cobranca {
  id               String         @id @default(uuid())
  osId             String         @unique @map("os_id")
  orcamentoId      String?        @map("orcamento_id")
  gatewayPaymentId String?        @unique @map("gateway_payment_id")
  valor            Decimal        @db.Decimal(10, 2)
  status           StatusCobranca
  checkoutUrl      String?        @map("checkout_url")
  correlationId    String?        @map("correlation_id")
  sagaId           String?        @map("saga_id")
  motivo           String?        @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@map("cobrancas")
}

// Simulated payment gateway (src/fake-gateway). Standalone on purpose: no FK
// to billing tables, as if it lived in a third-party provider.
enum FakeGatewayPagamentoStatus {
  pending
  approved
  declined
}

model FakeGatewayPagamento {
  id             String                     @id @default(uuid())
  idempotencyKey String                     @unique @map("idempotency_key")
  clientId       String                     @map("client_id")
  amountCents    Int                        @map("amount_cents")
  currency       String                     @default("BRL")
  description    String?
  status         FakeGatewayPagamentoStatus @default(pending)
  metadata       Json?
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  @@map("fake_gateway_pagamentos")
}
