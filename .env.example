DATABASE_URL=postgresql://oficina:oficina@localhost:5433/oficina_billing
PORT=3000
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:oficina-billing-events
OUTBOX_PUBLISH_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50
OUTBOX_PUBLISHER_ENABLED=true
SQS_QUEUE_URL=http://localhost:4566/000000000000/oficina-billing-queue
SQS_CONSUMER_ENABLED=true
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_MAX_MESSAGES=10
JWT_SECRET=change-me
# Simulated payment gateway (/gateway)
GATEWAY_CLIENT_ID=billing-local
GATEWAY_CLIENT_SECRET=change-me
GATEWAY_JWT_SECRET=change-me-gateway
PAYMENT_WEBHOOK_SECRET=change-me-webhook
GATEWAY_PUBLIC_BASE_URL=http://localhost:3000
PAYMENT_WEBHOOK_URL=http://localhost:3000/billing/webhooks/pagamento
# Base URL used by the billing adapter to call the gateway (no trailing slash)
GATEWAY_INTERNAL_BASE_URL=http://localhost:3000/gateway
